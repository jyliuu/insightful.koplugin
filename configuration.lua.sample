    -- Supported values: openai, deepseek, openrouter, anthropic.
    provider = "openai",

    -- Supply the complete endpoint for that provider.
    base_url = "https://api.openai.com/v1/chat/completions",
    model = "gpt-4.1-mini",
    api_key = "",

    timeout = 60,

    -- Optional generation overrides. Leave unset to use provider defaults.
